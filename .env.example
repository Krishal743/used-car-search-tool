# Create a Gemini API key in Google AI Studio. Use a project without paid billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# HTTP requests first; Chromium fallback for pages requiring rendering.
OLX_BROWSER_FALLBACK=true
OLX_REQUEST_DELAY=1.5
# Optional: complete public OLX search URL for a region not in the location list.
# Change result limits in the dashboard. No scheduled scraping.
